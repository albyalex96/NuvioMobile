<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locale_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nuvio">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Nuvio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="nuvio"
                    android:host="auth"
                    android:path="/trakt" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="nuvio"
                    android:host="auth"
                    android:path="/anilist" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".features.downloads.DownloadsNotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".features.player.AndroidNowPlayingActionReceiver"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.nuvio.app.features.player.cast.CastOptionsProvider" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity-alias
            android:name="com.nuvio.enhanced.IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity="com.nuvio.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.nuvio.enhanced.IconEnhanced"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt_enhanced"
            android:roundIcon="@mipmap/ic_launcher_alt_enhanced"
            android:targetActivity="com.nuvio.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.nuvio.enhanced.IconMonochrome"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt_monochrome"
            android:roundIcon="@mipmap/ic_launcher_alt_monochrome"
            android:targetActivity="com.nuvio.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.nuvio.enhanced.IconNeon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt_neon"
            android:roundIcon="@mipmap/ic_launcher_alt_neon"
            android:targetActivity="com.nuvio.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.nuvio.enhanced.IconGear"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt_gear"
            android:roundIcon="@mipmap/ic_launcher_alt_gear"
            android:targetActivity="com.nuvio.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.nuvio.enhanced.IconChrome"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt_chrome"
            android:roundIcon="@mipmap/ic_launcher_alt_chrome"
            android:targetActivity="com.nuvio.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.nuvio.enhanced.IconAurora"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt_aurora"
            android:roundIcon="@mipmap/ic_launcher_alt_aurora"
            android:targetActivity="com.nuvio.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.nuvio.enhanced.IconEmerald"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt_emerald"
            android:roundIcon="@mipmap/ic_launcher_alt_emerald"
            android:targetActivity="com.nuvio.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
