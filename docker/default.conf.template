server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  resolver 1.1.1.1 8.8.8.8 valid=300s;
  resolver_timeout 10s;

  gzip on;
  gzip_types text/plain text/css application/javascript application/wasm image/svg+xml;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_static on;

  # ── Security headers ──────────────────────────────────
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # ── SharedArrayBuffer (multithreading WASM) ───────────
  # credentialless instead of require-corp: non blocca le risorse
  # cross-origin che non inviano Cross-Origin-Resource-Policy.
  location ~* \.(?:js|wasm)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "credentialless" always;
  }

  # ── Asset caching ─────────────────────────────────────
  location /composeResources/ { expires 1y; add_header Cache-Control "public, immutable"; }
  location ~* \.map$ { expires -1; add_header Cache-Control "no-cache"; }
  location = /index.html { expires -1; add_header Cache-Control "no-cache, no-store, must-revalidate"; }
  location = /styles.css { expires 1y; add_header Cache-Control "public, immutable"; }

  # ── Proxy generico per richieste esterne (CORS bypass) ──
  # L'app instrada TUTTE le richieste HTTP verso server esterni
  # attraverso questo endpoint. nginx forwarda la richiesta
  # originale e aggiunge gli header CORS necessari.
  #
  # Uso: /ext-proxy/?url=https%3A%2F%2Ftarget.com%2Fpath
  location /ext-proxy/ {
    if ($arg_url = "") { return 400; }

    proxy_pass $arg_url;

    # SSL upstream (gli addon scraper usano HTTPS con cert vari)
    proxy_ssl_server_name on;
    proxy_ssl_verify off;

    # HTTP/1.1 per upstream (alcuni server richiedono keepalive)
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # Headers di forward
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Forward the original request method, headers, body
    proxy_pass_request_headers on;
    proxy_pass_request_body on;
    proxy_method $request_method;

    # CORS headers per la risposta proxata
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
    add_header Access-Control-Allow-Headers "*" always;
    add_header Access-Control-Expose-Headers "*" always;

    # Buffer per risposte grandi (video, immagini)
    proxy_buffering off;
    proxy_max_temp_file_size 0;

    # Timeout aumentati per stream video
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_connect_timeout 30s;
  }

  # ── Proxy specifici (per backward compatibilità) ─────
  location /tmdb-image/ {
    proxy_pass https://image.tmdb.org/t/p/;
    proxy_hide_header Cross-Origin-Resource-Policy;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;
    proxy_set_header Host image.tmdb.org;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  location /extendedratings/ {
    proxy_pass https://extendedratings.com/;
    proxy_hide_header Cross-Origin-Resource-Policy;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;
    proxy_set_header Host extendedratings.com;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # ── Fallback SPA ──────────────────────────────────────
  location / { try_files $uri /index.html; }
}
